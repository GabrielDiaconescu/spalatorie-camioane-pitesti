# Copiază acest fișier în .env.local și completează valorile reale.
# .env.local NU se urcă în git. Pe găzduire, setează aceleași variabile din panoul de control.

# Adresa publică a site-ului, fără „/” la final (folosită pentru canonical, sitemap și Open Graph).
NEXT_PUBLIC_SITE_URL=

# Cheia API Resend (din contul clientului: resend.com → API Keys).
RESEND_API_KEY=

# Expeditorul e-mailurilor; trebuie să fie pe un domeniu verificat în Resend.
# Exemplu de format: Site Spălătorie <formular@domeniul-tau.ro>
CONTACT_FROM_EMAIL=

# Adresa care primește mesajele din formulare (adresa clientului).
CONTACT_TO_EMAIL=

# Opțional, doar pentru teste automate: adresa API Resend (implicit https://api.resend.com/emails).
RESEND_API_URL=
